generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENTE
  ADMIN
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum Goal {
  BAJAR_PESO
  GANAR_MASA_MUSCULAR
  MAS_ENERGIA
  BIENESTAR_DIGESTIVO
  CUIDADO_DE_LA_PIEL
  SALUD_GENERAL
  RENDIMIENTO_DEPORTIVO
  CONTROL_DE_ESTRES
}

enum ActivityLevel {
  SEDENTARIO
  LIGERO
  MODERADO
  ALTO
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  phone         String?
  role          Role      @default(CLIENTE)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders            Order[]
  reviews           Review[]
  consultations     Consultation[]
  wishlist          WishlistItem[]
  addresses         Address[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  colorFrom   String    @default("#22c55e")
  colorTo     String    @default("#16a34a")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  products    Product[]
}

model Flavor {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  products  Product[]
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  products  Product[]
}

model Product {
  id              String    @id @default(cuid())
  sku             Int       @unique @default(autoincrement())
  name            String
  slug            String    @unique
  shortDescription String
  description     String
  size            String?
  benefits        String[]  @default([])
  howToUse        String?
  ingredients     String?
  price           Decimal   @db.Decimal(10, 2)
  compareAtPrice  Decimal?  @db.Decimal(10, 2)
  discountPercent Int       @default(0)
  image           String
  gallery         String[]  @default([])
  stock           Int       @default(50)
  rating          Decimal   @default(4.8) @db.Decimal(2, 1)
  reviewCount     Int       @default(0)
  tags            Goal[]    @default([])
  featured        Boolean   @default(false)
  bestSeller      Boolean   @default(false)
  isNew           Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])

  flavorId        String?
  flavor          Flavor?   @relation(fields: [flavorId], references: [id])

  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])

  orderItems      OrderItem[]
  reviews         Review[]
  wishlistedBy    WishlistItem[]
  recommendedIn   ConsultationRecommendation[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Address {
  id        String   @id @default(cuid())
  label     String   @default("Principal")
  fullName  String
  phone     String
  line1     String
  district  String
  city      String
  reference String?
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model Order {
  id            String       @id @default(cuid())
  code          String       @unique
  status        OrderStatus  @default(PENDIENTE)
  subtotal      Decimal      @db.Decimal(10, 2)
  discount      Decimal      @default(0) @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  note          String?
  whatsappSent  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  userId        String
  user          User         @relation(fields: [userId], references: [id])

  addressId     String?
  address       Address?     @relation(fields: [addressId], references: [id])

  items         OrderItem[]
  statusEvents  OrderStatusEvent[]
}

model OrderItem {
  id          String   @id @default(cuid())
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  productName String
  productImage String

  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Consultation {
  id            String    @id @default(cuid())
  goal          Goal
  activityLevel ActivityLevel?
  answers       Json
  summary       String?
  createdAt     DateTime  @default(now())

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  recommendations ConsultationRecommendation[]
}

model ConsultationRecommendation {
  id             String       @id @default(cuid())
  score          Int          @default(0)
  reason         String?

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  productId      String
  product        Product      @relation(fields: [productId], references: [id])

  @@unique([consultationId, productId])
}
